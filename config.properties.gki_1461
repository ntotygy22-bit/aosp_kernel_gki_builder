# Kernel Source
KERNEL_SOURCE=https://github.com/Mohithash/kernel_xiaomi_sm8635
KERNEL_SOURCE_BRANCH=main

# Config Path (Sesuai dengan screenshot defconfig yang lu kirim)
KERNEL_CONFIG=defconfig
KERNEL_IMAGE_NAME=Image
ARCH=arm64

# Compiler Settings (Wajib Clang, GCC Harus Mati)
ENABLE_CLANG=true
USE_AOSP_CLANG=true
AOSP_CLANG_SYSTEM=linux-x86
AOSP_CLANG_BRANCH=main
AOSP_CLANG_VERSION=stable

# PENTING: Matikan GCC total
ENABLE_GCC=false
ENABLE_AOSP_GCC_ARM64=false
ENABLE_AOSP_GCC_ARM32=false

# KernelSU
ENABLE_KERNELSU=true
KERNELSU_INSTALLER=https://raw.githubusercontent.com/tiann/KernelSU/main/kernel/setup.sh
KERNELSU_TAG=main

# Build Optimization
ENABLE_CCACHE=true
DISABLE-LTO=true
